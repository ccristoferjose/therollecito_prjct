# =============================================================================
# Next.js environment — migrated from Vite (VITE_* → NEXT_PUBLIC_*).
# NEXT_PUBLIC_* are exposed to the browser (safe: Firebase web config is public).
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay server-only.
# =============================================================================

# --- Browser-exposed (public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public site origin (used for canonical URLs, OG metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API + socket base URLs. Leave API empty in dev to use the Next rewrite proxy
# to BACKEND_ORIGIN; set in prod to the deployed backend URL.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# --- Server-only ---
# Where the Next server proxies /api (dev) and fetches during SSR.
# docker-compose overrides this to http://backend:3001.
BACKEND_ORIGIN=http://localhost:3001
