# =============================================================================
# Template for the backend env files. Copy to:
#   backend/.env             → dev/testing  (NODE_ENV=development, Stripe TEST keys)
#   backend/.env.production  → production   (NODE_ENV=production,  Stripe LIVE keys)
# Both are gitignored. The app always loads `.env`; in prod, .env.production is
# deployed AS .env (see scripts/deploy-env.sh).
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=
DB_NAME=restaurant_ordering
DB_CONNECTION_LIMIT=10

# JWT (staff auth)
JWT_SECRET=change-me-to-a-strong-random-string
JWT_EXPIRES_IN=8h

# Firebase (client auth — pick ONE method)
FIREBASE_PROJECT_ID=restaurant-ordering-yumyum
# Method 1: path to service account JSON file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=/Users/chrisch/.secrets/firebase-service-account.json
# Method 2: inline JSON string (production / AWS)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AWS S3 (image uploads — menu item photos, etc.)
# In production on EC2/ECS/EKS with an IAM role attached, you can omit
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY — the SDK falls back to
# instance metadata. S3_BUCKET is required to enable uploads at all.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=therollecito-uploads
# Optional: CloudFront / custom domain in front of the bucket.
# When set, public URLs use this base instead of s3.<region>.amazonaws.com.
# S3_PUBLIC_URL_BASE=https://cdn.example.com

# CORS
CORS_ORIGIN=http://localhost:5173

# Delivery (Uber Direct) — server-side ONLY. Never expose these to the frontend.
# Delivery is offered at checkout only when all three UBER_* ids are set.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
# Signing key from the Uber Direct dashboard webhook settings. Webhooks are
# rejected (fail closed) when this is missing. Endpoint: POST /api/webhooks/uber
UBER_WEBHOOK_SIGNING_KEY=
# UBER_API_BASE_URL=https://api.uber.com
# DELIVERY_ENABLED=true                      # kill switch
# DELIVERY_DEFAULT_PREP_MINUTES=20           # ASAP prep estimate when the service period has none
# DELIVERY_QUOTE_EXPIRY_BUFFER_SECONDS=60    # treat quotes as expired this early
# DELIVERY_MAX_RADIUS_MILES=                 # optional straight-line radius; unset = provider decides
# DELIVERY_GEOCODER=census                   # census | none
# DELIVERY_PICKUP_PHONE=+15555555555         # fallback when a location has no phone
